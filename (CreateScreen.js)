import React, { useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, TextInput, ActivityIndicator, Alert } from 'react-native';
import * as ImagePicker from 'expo-image-picker';
import { supabase } from '../supabaseClient';

export default function CreateScreen({ navigation }) {
  const [videoUri, setVideoUri] = useState(null);
  const [description, setDescription] = useState('');
  const [uploading, setUploading] = useState(false);

  // Sélectionner une vidéo dans la galerie
  const pickVideo = async () => {
    let result = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ImagePicker.MediaTypeOptions.Videos,
      allowsEditing: true,
      quality: 1,
    });

    if (!result.canceled) {
      setVideoUri(result.assets[0].uri);
    }
  };

  // Publier la vidéo sur Supabase Storage & DB
  const handleUpload = async () => {
    if (!videoUri) return Alert.alert('Attention', 'Veuillez sélectionner une vidéo');

    try {
      setUploading(true);
      const user = supabase.auth.user();
      
      const fileName = `${user.id}/${Date.now()}.mp4`;
      const response = await fetch(videoUri);
      const blob = await response.blob();

      // 1. Upload du fichier vidéo dans le bucket Storage 'videos'
      const { data, error: storageError } = await supabase.storage
        .from('videos')
        .upload(fileName, blob);

      if (storageError) throw storageError;

      // 2. Récupération de l'URL publique
      const { publicURL } = supabase.storage.from('videos').getPublicUrl(fileName);

      // 3. Enregistrement dans la table SQL 'videos'
      const { error: dbError } = await supabase.from('videos').insert([
        {
          user_id: user.id,
          video_url: publicURL,
          description: description,
        },
      ]);

      if (dbError) throw dbError;

      Alert.alert('Succès', 'Votre vidéo a été publiée sur NOVA !');
      setVideoUri(null);
      setDescription('');
      navigation.navigate('Home');
    } catch (err) {
      Alert.alert('Erreur', err.message);
    } finally {
      setUploading(false);
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.headerTitle}>Créer un contenu</Text>

      <TouchableOpacity style={styles.selectBtn} onPress={pickVideo}>
        <Text style={styles.selectBtnText}>
          {videoUri ? 'Changer la vidéo sélectionnée' : 'Sélectionner une vidéo'}
        </Text>
      </TouchableOpacity>

      <TextInput
        style={styles.input}
        placeholder="Écrivez une description..."
        placeholderTextColor="#666"
        multiline
        value={description}
        onChangeText={setDescription}
      />

      {uploading ? (
        <ActivityIndicator size="large" color="#FF2D55" style={{ marginTop: 20 }} />
      ) : (
        <TouchableOpacity style={styles.publishBtn} onPress={handleUpload}>
          <Text style={styles.publishBtnText}>Publier sur NOVA</Text>
        </TouchableOpacity>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#000', padding: 20, justifyContent: 'center' },
  headerTitle: { color: '#FFF', fontSize: 22, fontWeight: 'bold', marginBottom: 30, textAlign: 'center' },
  selectBtn: { backgroundColor: '#1E1E1E', padding: 20, borderRadius: 12, alignItems: 'center', marginBottom: 20, borderWidth: 1, borderColor: '#333' },
  selectBtnText: { color: '#FFF', fontWeight: '600' },
  input: { backgroundColor: '#1E1E1E', color: '#FFF', padding: 15, borderRadius: 12, height: 100, textAlignVertical: 'top', marginBottom: 20 },
  publishBtn: { backgroundColor: '#FF2D55', padding: 15, borderRadius: 12, alignItems: 'center' },
  publishBtnText: { color: '#FFF', fontSize: 16, fontWeight: 'bold' }
});
