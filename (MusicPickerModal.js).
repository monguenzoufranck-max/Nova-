import React from 'react';
import { StyleSheet, View, Text, Modal, TouchableOpacity, FlatList } from 'react-native';

const TRACKS = [
  { id: '1', title: 'Cyberpunk Vibe', artist: 'NOVA Sound', duration: '0:30' },
  { id: '2', title: 'Midnight Synth', artist: 'Neon Beats', duration: '0:45' },
  { id: '3', title: 'Afrorave Pulse', artist: 'DJ Solar', duration: '0:60' },
  { id: '4', title: 'Future Bass Gem', artist: 'Electro Gem', duration: '0:30' },
];

export default function MusicPickerModal({ visible, onClose, onSelectTrack }) {
  return (
    <Modal visible={visible} transparent animationType="slide">
      <View style={styles.overlay}>
        <View style={styles.glassContainer}>
          <Text style={styles.title}>🎵 Choisir une musique</Text>

          <FlatList
            data={TRACKS}
            keyExtractor={(item) => item.id}
            renderItem={({ item }) => (
              <TouchableOpacity 
                style={styles.trackRow}
                onPress={() => {
                  if (onSelectTrack) onSelectTrack(item);
                  onClose();
                }}
              >
                <View>
                  <Text style={styles.trackTitle}>{item.title}</Text>
                  <Text style={styles.trackArtist}>{item.artist}</Text>
                </View>
                <Text style={styles.trackDuration}>{item.duration}</Text>
              </TouchableOpacity>
            )}
          />

          <TouchableOpacity style={styles.closeButton} onPress={onClose}>
            <Text style={styles.closeButtonText}>Fermer</Text>
          </TouchableOpacity>
        </View>
      </View>
    </Modal>
  );
}

