import React, { useState } from 'react';
import { StyleSheet, Text, View, Modal, TouchableOpacity, FlatList, TextInput } from 'react-native';
import { Ionicons } from '@expo/vector-icons';

export default function CommentsModal({ visible, onClose }) {
  const [comments, setComments] = useState([
    { id: '1', user: 'Marc', text: 'Incroyable la qualité de cette vidéo ! 🔥', likes: 12, isLiked: false },
    { id: '2', user: 'Léa', text: 'Le design de NOVA est juste trop propre.', likes: 5, isLiked: true },
  ]);
  const [text, setText] = useState('');

  const toggleLikeComment = (commentId) => {
    setComments(comments.map(item => {
      if (item.id === commentId) {
        return {
          ...item,
          isLiked: !item.isLiked,
          likes: item.isLiked ? item.likes - 1 : item.likes + 1
        };
      }
      return item;
    }));
  };

  const addComment = () => {
    if (!text.trim()) return;
    setComments([
      ...comments, 
      { id: Date.now().toString(), user: 'Moi', text, likes: 0, isLiked: false }
    ]);
    setText('');
  };

  return (
    <Modal visible={visible} animationType="slide" transparent>
      <View style={styles.overlay}>
        <View style={styles.modalContent}>
          {/* En-tête */}
          <View style={styles.header}>
            <Text style={styles.title}>Commentaires ({comments.length})</Text>
            <TouchableOpacity onPress={onClose}>
              <Ionicons name="close" size={24} color="#FFF" />
            </TouchableOpacity>
          </View>

          {/* Liste des commentaires */}
          <FlatList
            data={comments}
            keyExtractor={(item) => item.id}
            renderItem={({ item }) => (
              <View style={styles.commentRow}>
                <View style={styles.commentBody}>
                  <Text style={styles.commentUser}>@{item.user}</Text>
                  <Text style={styles.commentText}>{item.text}</Text>
                </View>
                
                {/* Bouton Like de Commentaire */}
                <TouchableOpacity 
                  style={styles.likeBtn} 
                  onPress={() => toggleLikeComment(item.id)}
                >
                  <Ionicons 
                    name={item.isLiked ? "heart" : "heart-outline"} 
                    size={16} 
                    color={item.isLiked ? "#FF2D55" : "#666"} 
                  />
                  <Text style={[styles.likeCount, item.isLiked && styles.likedText]}>
                    {item.likes}
                  </Text>
                </TouchableOpacity>
              </View>
            )}
          />

          {/* Saisie */}
          <View style={styles.inputRow}>
            <TextInput
              style={styles.input}
              placeholder="Ajouter un commentaire..."
              placeholderTextColor="#666"
              value={text}
              onChangeText={setText}
            />
            <TouchableOpacity onPress={addComment}>
              <Ionicons name="send" size={20} color="#FF2D55" />
            </TouchableOpacity>
          </View>
        </View>
      </View>
    </Modal>
  );
}

const styles = StyleSheet.create({
  overlay: {
    flex: 1,
    backgroundColor: 'rgba(0,0,0,0.6)',
    justifyContent: 'flex-end',
  },
  modalContent: {
    backgroundColor: '#121212',
    borderTopLeftRadius: 20,
    borderTopRightRadius: 20,
    height: '60%',
    padding: 20,
  },
  header: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: 15,
  },
  title: { color: '#FFF', fontWeight: 'bold', fontSize: 16 },
  commentRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: 16,
  },
  commentBody: { flex: 1, paddingRight: 10 },
  commentUser: { color: '#FF2D55', fontWeight: 'bold', fontSize: 12 },
  commentText: { color: '#FFF', fontSize: 14, marginTop: 2 },
  likeBtn: { alignItems: 'center', width: 30 },
  likeCount: { color: '#666', fontSize: 10, marginTop: 2 },
  likedText: { color: '#FF2D55' },
  inputRow: {
    flexDirection: 'row',
    alignItems: 'center',
    backgroundColor: '#1E1E1E',
    borderRadius: 20,
    paddingHorizontal: 15,
    marginTop: 10,
  },
  input: { flex: 1, color: '#FFF', height: 40 },
});
