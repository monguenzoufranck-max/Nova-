import React, { useState, useEffect } from 'react';
import { 
  View, Text, StyleSheet, Image, FlatList, 
  TouchableOpacity, Dimensions, ActivityIndicator 
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { supabase } from '../supabaseClient';

const { width } = Dimensions.get('window');
const COLUMN_SIZE = width / 3;

export default function ProfileScreen({ navigation }) {
  const [profile, setProfile] = useState(null);
  const [userVideos, setUserVideos] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchProfileAndVideos();
  }, []);

  const fetchProfileAndVideos = async () => {
    try {
      setLoading(true);
      const user = supabase.auth.user();
      if (!user) return;

      // 1. Récupérer les données du profil
      const { data: profileData, error: profileError } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();

      if (profileError) throw profileError;
      setProfile(profileData);

      // 2. Récupérer les vidéos de cet utilisateur
      const { data: videosData, error: videosError } = await supabase
        .from('videos')
        .select('*')
        .eq('user_id', user.id)
        .order('created_at', { ascending: false });

      if (videosError) throw videosError;
      setUserVideos(videosData || []);
    } catch (err) {
      console.log('Erreur Profile:', err.message);
    } finally {
      setLoading(false);
    }
  };

  const renderHeader = () => (
    <View style={styles.headerContainer}>
      {/* Photo de profil */}
      <Image 
        source={{ uri: profile?.avatar_url || 'https://via.placeholder.com/150' }} 
        style={styles.avatar} 
      />
      
      <Text style={styles.username}>@{profile?.username || 'utilisateur'}</Text>
      
      {/* Statistiques (Abonnés, Abonnements, Likes) */}
      <View style={styles.statsRow}>
        <View style={styles.statItem}>
          <Text style={styles.statNumber}>0</Text>
          <Text style={styles.statLabel}>Abonnements</Text>
        </View>
        <View style={styles.statItem}>
          <Text style={styles.statNumber}>0</Text>
          <Text style={styles.statLabel}>Abonnés</Text>
        </View>
        <View style={styles.statItem}>
          <Text style={styles.statNumber}>
            {userVideos.reduce((acc, curr) => acc + (curr.likes_count || 0), 0)}
          </Text>
          <Text style={styles.statLabel}>J'aime</Text>
        </View>
      </View>

      {/* Bouton Éditer le profil */}
      <TouchableOpacity style={styles.editBtn}>
        <Text style={styles.editBtnText}>Éditer le profil</Text>
      </TouchableOpacity>
    </View>
  );

  const renderVideoItem = ({ item }) => (
    <TouchableOpacity style={styles.gridItem}>
      {/* Affichage miniature de la vidéo */}
      <View style={styles.videoPlaceholder}>
        <Ionicons name="play" size={20} color="#FFF" />
        <Text style={styles.likesText}>{item.likes_count || 0}</Text>
      </View>
    </TouchableOpacity>
  );

  if (loading) {
    return (
      <View style={styles.loaderContainer}>
        <ActivityIndicator size="large" color="#FF2D55" />
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <FlatList
        data={userVideos}
        keyExtractor={(item) => item.id.toString()}
        numColumns={3}
        ListHeaderComponent={renderHeader}
        renderItem={renderVideoItem}
        showsVerticalScrollIndicator={false}
        ListEmptyComponent={
          <Text style={styles.emptyText}>Aucune vidéo publiée pour l'instant.</Text>
        }
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#000' },
  loaderContainer: { flex: 1, backgroundColor: '#000', justifyContent: 'center', alignItems: 'center' },
  headerContainer: { alignItems: 'center', paddingTop: 40, paddingBottom: 20, borderBottomWidth: 1, borderBottomColor: '#222' },
  avatar: { width: 90, height: 90, borderRadius: 45, marginBottom: 10, backgroundColor: '#333' },
  username: { color: '#FFF', fontSize: 18, fontWeight: 'bold', marginBottom: 15 },
  statsRow: { flexDirection: 'row', justifyContent: 'space-around', width: '80%', marginBottom: 20 },
  statItem: { alignItems: 'center' },
  statNumber: { color: '#FFF', fontSize: 16, fontWeight: 'bold' },
  statLabel: { color: '#888', fontSize: 12, marginTop: 2 },
  editBtn: { borderWidth: 1, borderColor: '#444', paddingHorizontal: 30, paddingVertical: 8, borderRadius: 20 },
  editBtnText: { color: '#FFF', fontSize: 14, fontWeight: '600' },
  gridItem: { width: COLUMN_SIZE, height: COLUMN_SIZE * 1.3, padding: 1 },
  videoPlaceholder: { flex: 1, backgroundColor: '#1E1E1E', justifyContent: 'flex-end', padding: 8 },
  likesText: { color: '#FFF', fontSize: 12, marginLeft: 4 },
  emptyText: { color: '#666', textAlign: 'center', marginTop: 40 }
});
