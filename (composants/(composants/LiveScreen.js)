import React, { useState } from 'react';
import { StyleSheet, View, Text, TouchableOpacity, FlatList, TextInput } from 'react-native';
import GiftsModal from './GiftsModal';

export default function LiveScreen() {
  const [isLive, setIsLive] = useState(false);
  const [comments, setComments] = useState([]);
  const [text, setText] = useState('');
  const [showGifts, setShowGifts] = useState(false);

  const sendComment = () => {
    if (!text.trim()) return;
    setComments((prev) => [...prev, { id: Date.now().toString(), text }]);
    setText('');
  };

  return (
    <View style={styles.container}>
      {/* Zone Vidéo / Caméra */}
      <View style={styles.videoPlaceholder}>
        <Text style={styles.liveBadge}>{isLive ? '🔴 EN DIRECT' : '⏸️ HORS LIGNE'}</Text>
        
        {!isLive && (
          <TouchableOpacity style={styles.startBtn} onPress={() => setIsLive(true)}>
            <Text style={styles.startBtnText}>Lancer le Live 🎥</Text>
          </TouchableOpacity>
        )}
      </View>

      {/* Commentaires en direct */}
      <View style={styles.commentsOverlay}>
        <FlatList
          data={comments}
          keyExtractor={(item) => item.id}
          renderItem={({ item }) => (
            <View style={styles.commentBubble}>
              <Text style={styles.commentText}>💬 {item.text}</Text>
            </View>
          )}
        />
      </View>

      {/* Barre d'action Live */}
      {isLive && (
        <View style={styles.liveBar}>
          <TextInput
            style={styles.input}
            placeholder="Réagir en direct..."
            placeholderTextColor="#8E8E93"
            value={text}
            onChangeText={setText}
          />
          <TouchableOpacity style={styles.sendBtn} onPress={sendComment}>
            <Text style={styles.btnIcon}>➔</Text>
          </TouchableOpacity>
          <TouchableOpacity style={styles.giftBtn} onPress={() => setShowGifts(true)}>
            <Text style={styles.btnIcon}>🎁</Text>
          </TouchableOpacity>
        </View>
      )}

      {/* Modale des Cadeaux */}
      <GiftsModal
        visible={showGifts}
        onClose={() => setShowGifts(false)}
        receiverId="LIVE_HOST_ID"
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#000' },
  videoPlaceholder: { flex: 1, justifyContent: 'center', alignItems: 'center', backgroundColor: '#1A1A2E' },
  liveBadge: { position: 'absolute', top: 50, left: 20, backgroundColor: 'rgba(255,42,133,0.8)', color: '#FFF', paddingHorizontal: 12, paddingVertical: 6, borderRadius: 12, fontWeight: 'bold' },
  startBtn: { backgroundColor: '#00F0FF', paddingHorizontal: 24, paddingVertical: 14, borderRadius: 25 },
  startBtnText: { color: '#000', fontWeight: 'bold', fontSize: 16 },
  commentsOverlay: { height: 180, paddingHorizontal: 16 },
  commentBubble: { backgroundColor: 'rgba(0,0,0,0.5)', padding: 8, borderRadius: 12, marginBottom: 6, alignSelf: 'flex-start' },
  commentText: { color: '#FFF', fontSize: 13 },
  liveBar: { flexDirection: 'row', padding: 12, backgroundColor: '#0F0F1A', alignItems: 'center', gap: 8 },
  input: { flex: 1, backgroundColor: '#1A1A2E', borderRadius: 20, paddingHorizontal: 14, color: '#FFF', height: 40 },
  sendBtn: { backgroundColor: '#FF2A85', width: 40, height: 40, borderRadius: 20, justifyContent: 'center', alignItems: 'center' },
  giftBtn: { backgroundColor: '#FFD700', width: 40, height: 40, borderRadius: 20, justifyContent: 'center', alignItems: 'center' },
  btnIcon: { fontSize: 18 }
});
