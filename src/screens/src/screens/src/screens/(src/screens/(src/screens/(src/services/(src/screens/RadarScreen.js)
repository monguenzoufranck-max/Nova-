import React, { useState, useEffect } from 'react';
import { StyleSheet, View, Text, TouchableOpacity, Image, Dimensions } from 'react-native';
import MapView, { Marker, PROVIDER_GOOGLE } from 'react-native-maps';
import * as Location from 'expo-location';
import { Ionicons } from '@expo/vector-icons';

const { width, height } = Dimensions.get('window');

// Style Dark Mode personnalisé pour Google Maps
const darkMapStyle = [
  { elementType: 'geometry', stylers: [{ color: '#121212' }] },
  { elementType: 'labels.text.stroke', stylers: [{ color: '#121212' }] },
  { elementType: 'labels.text.fill', stylers: [{ color: '#746855' }] },
  { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#1E1E1E' }] },
  { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#000000' }] },
];

export default function RadarScreen({ navigation }) {
  const [location, setLocation] = useState(null);
  const [nearbyVideos, setNearbyVideos] = useState([
    { id: '1', title: 'Session Dance', latitude: -4.2634, longitude: 15.2429, isLive: true, user: 'Alex' },
    { id: '2', title: 'Street Art Center', latitude: -4.2680, longitude: 15.2500, isLive: false, user: 'Sarah' },
  ]);

  useEffect(() => {
    (async () => {
      let { status } = await Location.requestForegroundPermissionsAsync();
      if (status !== 'granted') return;

      let currentLocation = await Location.getCurrentPositionAsync({});
      setLocation(currentLocation.coords);
    })();
  }, []);

  return (
    <View style={styles.container}>
      {location ? (
        <MapView
          provider={PROVIDER_GOOGLE}
          style={styles.map}
          customMapStyle={darkMapStyle}
          initialRegion={{
            latitude: location.latitude,
            longitude: location.longitude,
            latitudeDelta: 0.05,
            longitudeDelta: 0.05,
          }}
        >
          {nearbyVideos.map((item) => (
            <Marker
              key={item.id}
              coordinate={{ latitude: item.latitude, longitude: item.longitude }}
              onPress={() => item.isLive ? navigation.navigate('Live') : navigation.navigate('Accueil')}
            >
              <View style={[styles.markerContainer, item.isLive && styles.markerLive]}>
                <Ionicons name={item.isLive ? "radio" : "play"} size={18} color="#FFF" />
              </View>
            </Marker>
          ))}
        </MapView>
      ) : (
        <View style={styles.loadingBox}>
          <Text style={styles.loadingText}>Recherche des signaux NOVA autour de vous...</Text>
        </View>
      )}

      {/* Titre Radar */}
      <View style={styles.headerBadge}>
        <Ionicons name="compass" size={20} color="#FF2D55" style={{ marginRight: 6 }} />
        <Text style={styles.headerText}>NOVA Radar</Text>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#000' },
  map: { width: width, height: height },
  loadingBox: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  loadingText: { color: '#888', fontSize: 14 },
  headerBadge: {
    position: 'absolute',
    top: 50,
    left: 20,
    flexDirection: 'row',
    alignItems: 'center',
    backgroundColor: 'rgba(18, 18, 18, 0.85)',
    paddingHorizontal: 16,
    paddingVertical: 10,
    borderRadius: 25,
    borderWidth: 1,
    borderColor: '#222',
  },
  headerText: { color: '#FFF', fontWeight: 'bold', fontSize: 16 },
  markerContainer: {
    width: 40,
    height: 40,
    borderRadius: 20,
    backgroundColor: '#1E1E1E',
    justifyContent: 'center',
    alignItems: 'center',
    borderWidth: 2,
    borderColor: '#FF2D55',
  },
  markerLive: {
    backgroundColor: '#FF2D55',
    borderColor: '#FFF',
  },
});
