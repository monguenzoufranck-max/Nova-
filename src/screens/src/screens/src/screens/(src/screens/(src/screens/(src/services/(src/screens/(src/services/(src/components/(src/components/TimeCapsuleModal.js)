import React, { useState } from 'react';
import { StyleSheet, Text, View, Modal, TouchableOpacity, TextInput } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';

export default function TimeCapsuleModal({ visible, onClose, onLockCapsule }) {
  const [unlockDays, setUnlockDays] = useState('7');

  return (
    <Modal visible={visible} animationType="slide" transparent>
      <View style={styles.overlay}>
        <View style={styles.card}>
          <Ionicons name="time" size={40} color="#00E5FF" style={styles.icon} />
          <Text style={styles.title}>Créer une Capsule NOVA</Text>
          <Text style={styles.subtitle}>
            Verrouillez cette vidéo à votre position actuelle.
          </Text>

          <Text style={styles.label}>Déverrouillage dans (jours) :</Text>
          <TextInput
            style={styles.input}
            keyboardType="numeric"
            value={unlockDays}
            onChangeText={setUnlockDays}
          />

          <TouchableOpacity 
            style={styles.btnWrapper} 
            onPress={() => onLockCapsule(unlockDays)}
            activeOpacity={0.8}
          >
            <LinearGradient
              colors={['#00E5FF', '#0088FF']}
              start={{ x: 0, y: 0 }}
              end={{ x: 1, y: 0 }}
              style={styles.btn}
            >
              <Text style={styles.btnText}>Sceller la Capsule 🔒</Text>
            </LinearGradient>
          </TouchableOpacity>

          <TouchableOpacity onPress={onClose} style={styles.closeBtn}>
            <Text style={styles.closeText}>Annuler</Text>
          </TouchableOpacity>
        </View>
      </View>
    </Modal>
  );
}

