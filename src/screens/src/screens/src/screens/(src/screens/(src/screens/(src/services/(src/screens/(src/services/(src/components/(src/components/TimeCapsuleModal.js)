    borderWidth: 1,
    borderColor: 'rgba(0, 229, 255, 0.3)',
  },
  icon: { marginBottom: 10 },
  title: { color: '#FFF', fontSize: 20, fontWeight: 'bold', marginBottom: 6 },
  subtitle: { color: '#AAA', fontSize: 13, textAlign: 'center', marginBottom: 20 },
  label: { color: '#FFF', alignSelf: 'flex-start', marginBottom: 8, fontSize: 13 },
  input: {
    backgroundColor: '#1E1E1E',
    color: '#00E5FF',
    width: '100%',
