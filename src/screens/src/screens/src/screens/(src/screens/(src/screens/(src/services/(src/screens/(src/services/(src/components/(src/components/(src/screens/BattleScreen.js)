  headerTitle: { color: '#FFF', fontSize: 18, fontWeight: 'bold', marginBottom: 15 },
  battleBox: { width: width - 20, height: height * 0.7, borderRadius: 20, overflow: 'hidden' },
  videoHalf: { flex: 1, backgroundColor: '#12121A', padding: 15, justifyContent: 'space-between' },
  creatorTag: { color: '#FFF', fontWeight: 'bold', fontSize: 14 },
