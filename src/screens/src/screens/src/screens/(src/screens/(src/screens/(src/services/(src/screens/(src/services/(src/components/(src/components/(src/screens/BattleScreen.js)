export default function BattleScreen() {
  const [votesA, setVotesA] = useState(120);
  const [votesB, setVotesB] = useState(98);

  return (
    <View style={styles.container}>
      <Text style={styles.headerTitle}>Local Battle ⚔️ Brazzaville</Text>

      {/* Duel Vidéo Split-Screen */}
      <View style={styles.battleBox}>
        {/* Vidéo A */}
        <TouchableOpacity 
          style={styles.videoHalf} 
          onPress={() => setVotesA(prev => prev + 1)}
          activeOpacity={0.9}
        >
          <Text style={styles.creatorTag}>@candidat_a</Text>
          <View style={styles.voteBadge}>
            <Ionicons name="flame" size={16} color="#FF2D55" />
            <Text style={styles.voteText}>{votesA}</Text>
          </View>
        </TouchableOpacity>

        {/* Séparateur VS */}
        <View style={styles.vsBadge}>
          <Text style={styles.vsText}>VS</Text>
        </View>

        {/* Vidéo B */}
        <TouchableOpacity 
          style={[styles.videoHalf, { backgroundColor: '#181824' }]} 
          onPress={() => setVotesB(prev => prev + 1)}
          activeOpacity={0.9}
        >
          <Text style={styles.creatorTag}>@candidat_b</Text>
          <View style={styles.voteBadge}>
            <Ionicons name="flame" size={16} color="#00E5FF" />
            <Text style={styles.voteText}>{votesB}</Text>
          </View>
        </TouchableOpacity>
      </View>

      <Text style={styles.instruction}>Appuyez sur votre vidéo préférée pour voter !</Text>
    </View>
  );
}

