import React from 'react';
import { TouchableOpacity, Text, StyleSheet, Share } from 'react-native';
import { Ionicons } from '@expo/vector-icons';

export default function ShareButton({ videoUrl }) {
  const handleShare = async () => {
    try {
      await Share.share({
        message: `Regarde cette vidéo sur NOVA ! 🚀\n${videoUrl}`,
      });
    } catch (error) {
      console.log('Erreur lors du partage :', error.message);
    }
  };

  return (
    <TouchableOpacity style={styles.container} onPress={handleShare}>
      <Ionicons name="share-social-outline" size={32} color="#FFF" />
      <Text style={styles.text}>Partager</Text>
    </TouchableOpacity>
  );
}

const styles = StyleSheet.create({
  container: { alignItems: 'center', marginTop: 20 },
  text: { color: '#FFF', fontSize: 12, marginTop: 4, fontWeight: 'bold' },
});
